# Domain only; do not include https:// or a path.
DOMAIN=counter.example.com

# Supabase project settings. NEXT_PUBLIC_* values are included in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only credentials. Never use the Supabase service role key as an anon key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
CRON_SECRET=replace-with-a-long-random-secret
